{
  "$schema": "./agent-crm-intents.schema.json",
  "schema_version": "sumi.agent-crm-intent-registry.v1",
  "intent_schema_version": "sumi.agent-crm-understanding.v1",
  "action_schema_version": "sumi.agent-crm-action.v1",
  "training_example_schema_version": "sumi.agent-crm-training-example.v1",
  "intents": [
    {
      "id": "crm.search",
      "status": "implemented",
      "effect": "read",
      "authorization_action": "crm.search",
      "resource_types": ["customer", "deal"],
      "review_policy": "provider_or_policy",
      "handler": "search",
      "required_entity_paths": [],
      "allowed_missing_paths": [
        "query.value",
        "customer.value",
        "deal.value",
        "selection"
      ],
      "required_evidence": ["input_digest", "request_fingerprint"],
      "entity_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "query": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "value": { "type": "string", "minLength": 1, "maxLength": 512 },
              "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
            }
          },
          "customer": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "value": { "type": "string", "minLength": 1, "maxLength": 128 },
              "name": { "type": "string", "minLength": 1, "maxLength": 256 },
              "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
            }
          },
          "deal": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "value": { "type": "string", "minLength": 1, "maxLength": 128 },
              "name": { "type": "string", "minLength": 1, "maxLength": 256 },
              "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
            }
          }
        }
      }
    },
    {
      "id": "crm.customer.create",
      "status": "implemented",
      "effect": "write",
      "authorization_action": "crm.customer.create",
      "resource_types": ["customer"],
      "review_policy": "required",
      "handler": "customer.create",
      "required_entity_paths": ["customer.name"],
      "allowed_missing_paths": ["customer.name", "selection"],
      "required_evidence": ["input_digest", "request_fingerprint"],
      "entity_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "customer": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string", "minLength": 1, "maxLength": 256 },
              "preferred_language": {
                "type": "string",
                "enum": ["zh-CN", "en-US", "hi-IN", "te-IN"]
              },
              "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
            }
          }
        }
      }
    },
    {
      "id": "crm.deal.update_stage",
      "status": "implemented",
      "effect": "write",
      "authorization_action": "crm.deal.update_stage",
      "resource_types": ["deal"],
      "review_policy": "required",
      "handler": "deal.update_stage",
      "required_entity_paths": ["deal.value", "stage.value"],
      "allowed_missing_paths": ["deal.value", "stage.value", "selection"],
      "required_evidence": ["input_digest", "request_fingerprint"],
      "entity_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "deal": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "value": { "type": "string", "minLength": 1, "maxLength": 128 },
              "name": { "type": "string", "minLength": 1, "maxLength": 256 },
              "expected_version": { "type": "integer", "minimum": 0 },
              "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
            }
          },
          "stage": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "value": { "type": "string", "minLength": 1, "maxLength": 128 },
              "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
            }
          }
        }
      }
    }
  ]
}
