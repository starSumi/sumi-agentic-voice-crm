# Protocol projections are generated from contracts/ and never hand-edited.
# Keep the checked-in projections under protocol/schema/json and
# packages/api-client/src/generated for offline, version-pinned consumers.
protocol/.tmp/
protocol/.cache/
packages/api-client/.tmp/

# Agent control plane and development-only evidence are maintained locally by
# the WSL2 Commander. They are not product source or release evidence.
.agent/
.local/
.agent.local/
.agent-runtime/
.agent-cache/
.agent-artifacts/
.agent-work/
.agent-*.log
.agent-*.jsonl
# Ad-hoc agent files at repository root are local-only; the versioned
# governance directory remains intentionally tracked.
.agent-*.json
.agent-*.tmp

# Local agent/client session and editor state is never project source.
.codex/
.claude/
.vscode/
.idea/
*.code-workspace
