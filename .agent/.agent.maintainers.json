{
  "schema_version": "sumi.agent-maintainers.v1",
  "repository": "sumi-agentic-voice-crm",
  "maintainers": {
    "documentation": {
      "accountable_role": "docs-maintainer",
      "github_owners": ["@starSumi"],
      "paths": [
        "docs/",
        "README.md",
        "astro.config.mjs",
        "src/content.config.ts",
        "integrations/sumi-docs-publisher.mjs"
      ],
      "review_interval_days": 30,
      "last_reviewed_at": "2026-08-14T21:26:46+08:00",
      "last_reviewed_commit": "0473b96124b8029074c551c94dee7c678e05d1e6"
    },
    "continuity": {
      "accountable_role": "continuity-supervisor",
      "github_owners": ["@starSumi"],
      "paths": [".agent/", "AGENTS.md", "scripts/agent-ops.mjs"],
      "review_interval_days": 14,
      "last_reviewed_at": "2026-08-14T21:26:46+08:00",
      "last_reviewed_commit": "0473b96124b8029074c551c94dee7c678e05d1e6"
    },
    "ci_operations": {
      "accountable_role": "ci-operations-agent",
      "github_owners": ["@starSumi"],
      "paths": [
        ".github/workflows/",
        "scripts/agent-incident.mjs",
        "scripts/agent-ops.mjs"
      ],
      "review_interval_days": 30,
      "last_reviewed_at": "2026-08-14T21:26:46+08:00",
      "last_reviewed_commit": "0473b96124b8029074c551c94dee7c678e05d1e6"
    }
  },
  "refresh_rule": "The accountable human owner reviews each surface before its interval expires and updates both review fields in the same reviewed change.",
  "rollback_rule": "Revert the maintainer change and restore the previous CODEOWNERS mapping; never infer approval from an automated agent run."
}
