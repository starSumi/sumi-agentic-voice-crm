{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sumi.invalid/schemas/dev-orchestration/runtime-state/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plan_id", "tasks"],
  "properties": {
    "schema_version": { "const": "sumi.dev-runtime-state.v1" },
    "plan_id": { "type": "string", "minLength": 8, "maxLength": 160 },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/taskState" }
    }
  },
  "$defs": {
    "taskState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "version",
        "observed_generation",
        "state",
        "attempt",
        "evidence",
        "updated_at"
      ],
      "properties": {
        "task_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[_-][a-z0-9]+)*$"
        },
        "version": { "type": "integer", "minimum": 1 },
        "observed_generation": { "type": "integer", "minimum": 0 },
        "state": {
          "enum": [
            "planned",
            "admitted",
            "running",
            "verifying",
            "blocked",
            "completed",
            "failed",
            "cancelled"
          ]
        },
        "attempt": { "type": "integer", "minimum": 0 },
        "owner_epoch": { "type": "string", "minLength": 8, "maxLength": 160 },
        "evidence": {
          "type": "object",
          "propertyNames": { "pattern": "^[a-z][a-z0-9]*(?:[_-][a-z0-9]+)*$" },
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "error_code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" },
        "updated_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}
