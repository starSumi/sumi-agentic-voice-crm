{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sumi.invalid/schemas/dev-orchestration/task-packet/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "workflow",
    "stage",
    "role",
    "objective",
    "generation",
    "idempotency_key",
    "priority",
    "read_paths",
    "write_paths",
    "depends_on",
    "acceptance_commands",
    "evidence_requirements",
    "timeout",
    "retry"
  ],
  "properties": {
    "schema_version": { "const": "sumi.dev-task.v1" },
    "task_id": { "$ref": "#/$defs/id" },
    "workflow": { "$ref": "#/$defs/id" },
    "stage": { "$ref": "#/$defs/id" },
    "role": { "$ref": "#/$defs/id" },
    "objective": { "type": "string", "minLength": 12, "maxLength": 500 },
    "generation": { "type": "integer", "minimum": 1 },
    "idempotency_key": { "type": "string", "minLength": 8, "maxLength": 160 },
    "priority": { "type": "integer", "minimum": 0, "maximum": 100 },
    "read_paths": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/path" }
    },
    "write_paths": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/path" }
    },
    "depends_on": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "acceptance_commands": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 3, "maxLength": 300 }
    },
    "evidence_requirements": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "timeout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["soft_ms", "hard_grace_ms", "teardown_ms"],
      "properties": {
        "soft_ms": { "type": "integer", "minimum": 100 },
        "hard_grace_ms": { "type": "integer", "minimum": 10 },
        "teardown_ms": { "type": "integer", "minimum": 10 }
      }
    },
    "retry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_attempts", "base_delay_ms", "max_delay_ms"],
      "properties": {
        "max_attempts": { "type": "integer", "minimum": 1, "maximum": 10 },
        "base_delay_ms": { "type": "integer", "minimum": 1 },
        "max_delay_ms": { "type": "integer", "minimum": 1 }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[_-][a-z0-9]+)*$" },
    "path": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!\\.\\.?$)[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
    }
  }
}
