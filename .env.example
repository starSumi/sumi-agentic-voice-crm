APP_ENV=local
PORT=8080
PUBLIC_BASE_URL=http://127.0.0.1:8080
DOCS_SITE_URL=http://127.0.0.1:4321
STORE_PROVIDER=memory
DATABASE_URL=postgresql://localhost:5432/sumi_voice_crm
DATABASE_POOL_MAX=10
DATA_ENCRYPTION_KEY=
AUTH_MODE=development
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URI=
OIDC_ALLOWED_ALGORITHMS=RS256,ES256
OIDC_TENANT_CLAIM=tenant_id
OIDC_REQUIRED_SCOPE=crm:write
OIDC_JWKS_TIMEOUT_MS=5000
ASR_PROVIDER=mock
INTENT_PROVIDER=mock
TTS_PROVIDER=mock
PROVIDER_TIMEOUT_MS=15000
OBJECT_STORAGE_PROVIDER=memory
OBJECT_STORAGE_BUCKET=voice-crm-private
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_FORCE_PATH_STYLE=false
OBJECT_STORAGE_PREFIX=voice-crm
OBJECT_STORAGE_SIGNED_URL_TTL_SECONDS=60
OBJECT_STORAGE_KMS_KEY_ID=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
OPENAI_ASR_MODEL=whisper-1
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy
OPENAI_TTS_MAX_BYTES=10485760
PROVIDER_TTS_MAX_BYTES=10485760
OPENAI_ACTOR_AUTHORIZATION=
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen-plus
DASHSCOPE_ASR_MODEL=qwen3-asr-flash
DASHSCOPE_TTS_MODEL=qwen3-tts-flash
DASHSCOPE_TTS_VOICE=Cherry
DASHSCOPE_TTS_MAX_BYTES=10485760
DASHSCOPE_AUDIO_HOST_SUFFIXES=
# Existing deployment aliases; DASHSCOPE_* takes precedence when both are set.
ALIYUN_BASE_APIKEY=
ALIYUN_BASE_URL=
ALIYUN_BASE_MODEL=
ALIYUN_ASR_MODEL=
ALIYUN_TTS_MODEL=
ALIYUN_TTS_VOICE=
ALIYUN_TTS_MAX_BYTES=
ALIYUN_AUDIO_HOST_SUFFIXES=
