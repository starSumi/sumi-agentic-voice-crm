{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false
  },
  "include": [".astro/types.d.ts", "src/**/*", "scripts/**/*", "integrations/**/*", "packages/api-client/src/**/*"],
  "exclude": [
    ".agent",
    "dist",
    "artifacts",
    ".agent/**",
    ".agent.local/**",
    ".agent-runtime/**",
    ".agent-cache/**",
    ".agent-artifacts/**",
    ".agent-work/**"
  ]
}
