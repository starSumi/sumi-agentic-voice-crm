{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://protocol.sumi.invalid/agent-crm/provider-output/v1/schema.json",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intent",
        "confidence",
        "entities",
        "missing",
        "needs_confirmation"
      ],
      "properties": {
        "intent": {
          "const": "crm.search"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "entities": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "query": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "value": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                },
                "confidence": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              }
            },
            "customer": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "value": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "confidence": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              }
            },
            "deal": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "value": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "confidence": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              }
            }
          }
        },
        "missing": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "query.value",
              "customer.value",
              "deal.value",
              "selection"
            ]
          }
        },
        "needs_confirmation": {
          "type": "boolean"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intent",
        "confidence",
        "entities",
        "missing",
        "needs_confirmation"
      ],
      "properties": {
        "intent": {
          "const": "crm.customer.create"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "entities": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "customer": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "preferred_language": {
                  "type": "string",
                  "enum": [
                    "zh-CN",
                    "en-US",
                    "hi-IN",
                    "te-IN"
                  ]
                },
                "confidence": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              }
            }
          }
        },
        "missing": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "customer.name",
              "selection"
            ]
          }
        },
        "needs_confirmation": {
          "const": true
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intent",
        "confidence",
        "entities",
        "missing",
        "needs_confirmation"
      ],
      "properties": {
        "intent": {
          "const": "crm.deal.update_stage"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "entities": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "deal": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "value": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "expected_version": {
                  "type": "integer",
                  "minimum": 0
                },
                "confidence": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              }
            },
            "stage": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "value": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "confidence": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              }
            }
          }
        },
        "missing": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "deal.value",
              "stage.value",
              "selection"
            ]
          }
        },
        "needs_confirmation": {
          "const": true
        }
      }
    }
  ]
}
