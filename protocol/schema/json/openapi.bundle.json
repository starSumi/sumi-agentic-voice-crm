{
  "openapi": "3.1.0",
  "jsonSchemaDialect": "https://spec.openapis.org/oas/3.1/dialect/base",
  "info": {
    "title": "Sumi Agentic Voice CRM API",
    "version": "1.0.0",
    "description": "Contract-first text/audio CRM interaction API. Provider implementations are replaceable adapters. Every mutation is bearer-authenticated, tenant scoped, and idempotent."
  },
  "servers": [
    {
      "url": "http://localhost:8080"
    }
  ],
  "x-sumi-error-policy": {
    "INVALID_REQUEST": {
      "status": 400,
      "retryable": false
    },
    "UNAUTHORIZED": {
      "status": 401,
      "retryable": false
    },
    "FORBIDDEN": {
      "status": 403,
      "retryable": false
    },
    "UNSUPPORTED_MEDIA": {
      "status": 415,
      "retryable": false
    },
    "NO_AUDIO_SOURCE": {
      "status": 422,
      "retryable": false
    },
    "EMPTY_TRANSCRIPT": {
      "status": 422,
      "retryable": false
    },
    "INTENT_LOW_CONFIDENCE": {
      "status": 202,
      "retryable": false
    },
    "CRM_CONFLICT": {
      "status": 409,
      "retryable": true
    },
    "ASR_TIMEOUT": {
      "status": 504,
      "retryable": true
    },
    "IDEMPOTENCY_CONFLICT": {
      "status": 409,
      "retryable": false
    },
    "UPSTREAM_UNAVAILABLE": {
      "status": 503,
      "retryable": true
    },
    "PROVIDER_REJECTED": {
      "status": 502,
      "retryable": false
    },
    "RATE_LIMITED": {
      "status": 429,
      "retryable": true
    },
    "PAYLOAD_TOO_LARGE": {
      "status": 413,
      "retryable": false
    }
  },
  "x-sumi-request-body-limits": {
    "ask_json_bytes": 37748736,
    "ask_multipart_bytes": 28311552,
    "tts_json_bytes": 131072,
    "review_json_bytes": 131072
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/ask": {
      "post": {
        "operationId": "ask",
        "x-sumi-action": "interaction.ask",
        "summary": "Ask the agent using text or audio",
        "parameters": [
          {
            "$ref": "#/components/parameters/TenantId"
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AskRequest"
              }
            },
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/MultipartAudioAskRequest"
              },
              "encoding": {
                "audio": {
                  "contentType": "audio/wav, audio/x-wav, audio/mpeg, audio/mp4, audio/webm"
                },
                "metadata": {
                  "contentType": "application/json"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Completed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AskResponse"
                }
              }
            }
          },
          "202": {
            "description": "Review required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReviewResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "413": {
            "$ref": "#/components/responses/Error"
          },
          "415": {
            "$ref": "#/components/responses/Error"
          },
          "422": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          },
          "502": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          },
          "504": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/v1/tts/synthesize": {
      "post": {
        "operationId": "synthesize",
        "x-sumi-action": "media.tts.create",
        "summary": "Synthesize a text response into an audio asset",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/TenantId"
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TtsRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Audio asset",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TtsSynthesizeResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "413": {
            "$ref": "#/components/responses/Error"
          },
          "422": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          },
          "502": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          },
          "504": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/v1/reviews/{review_id}/decision": {
      "post": {
        "operationId": "decideReview",
        "x-sumi-action": "review.decide",
        "summary": "Approve or reject a low-confidence agent decision",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/TenantId"
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          },
          {
            "name": "review_id",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/ReviewId"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReviewDecisionRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Review decision recorded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReviewDecisionResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "413": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/v1/assets/{asset_id}": {
      "get": {
        "operationId": "getAsset",
        "x-sumi-action": "media.asset.read",
        "summary": "Resolve tenant-scoped attachment metadata",
        "description": "Returns only opaque attachment metadata. The response never includes an object-storage key, credentials or signed URL query parameters.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/TenantId"
          },
          {
            "$ref": "#/components/parameters/AssetId"
          }
        ],
        "responses": {
          "200": {
            "description": "Attachment metadata",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AttachmentRef"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/v1/assets/{asset_id}/content": {
      "get": {
        "operationId": "getAssetContent",
        "x-sumi-action": "media.asset.read",
        "summary": "Download tenant-scoped attachment content",
        "description": "Authenticated binary retrieval for clients that cannot attach bearer credentials to media elements. Clients should fetch this operation and create a local object URL; raw bytes are never returned by getAsset.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/TenantId"
          },
          {
            "$ref": "#/components/parameters/AssetId"
          }
        ],
        "responses": {
          "200": {
            "description": "Attachment bytes using the stored media type",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string"
                },
                "description": "Private cache policy selected by the server."
              },
              "Content-Type": {
                "schema": {
                  "$ref": "#/components/schemas/AttachmentMimeType"
                }
              }
            },
            "content": {
              "application/octet-stream": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/v1/events": {
      "get": {
        "operationId": "listEvents",
        "x-sumi-action": "events.read",
        "summary": "List tenant-scoped durable domain events",
        "description": "Returns the HTTP projection of the normative CloudEvents envelope. Event semantics and event type evolution remain owned by events.yaml.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/TenantId"
          }
        ],
        "responses": {
          "200": {
            "description": "Tenant event stream snapshot",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventStreamResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT or opaque token",
        "description": "Tenant-scoped credential. Production supports verified OIDC JWTs or a private single-tenant static bearer token bound to a configured tenant and subject."
      }
    },
    "parameters": {
      "TenantId": {
        "name": "X-Tenant-Id",
        "in": "header",
        "required": false,
        "description": "Tenant boundary selected by an OIDC actor. Optional in static mode because the server binds the credential to one configured tenant; a conflicting value is rejected.",
        "schema": {
          "$ref": "#/components/schemas/TenantId"
        }
      },
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "description": "Stable mutation key. Reuse with a different request fingerprint returns 409.",
        "schema": {
          "$ref": "#/components/schemas/IdempotencyKey"
        }
      },
      "AssetId": {
        "name": "asset_id",
        "in": "path",
        "required": true,
        "description": "Opaque tenant-scoped attachment identifier.",
        "schema": {
          "$ref": "#/components/schemas/AttachmentId"
        }
      }
    },
    "responses": {
      "Error": {
        "description": "Stable Sumi error envelope. The request_id can be used to correlate audit and event records.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorEnvelope"
            }
          }
        }
      }
    },
    "schemas": {
      "TenantId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
      },
      "IdempotencyKey": {
        "type": "string",
        "minLength": 8,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9._:-]{8,128}$"
      },
      "Locale": {
        "type": "string",
        "enum": [
          "zh-CN",
          "en-US",
          "hi-IN",
          "te-IN"
        ],
        "default": "zh-CN"
      },
      "RequestId": {
        "type": "string",
        "pattern": "^req_[0-9a-f]{24}$"
      },
      "AttachmentId": {
        "type": "string",
        "minLength": 12,
        "maxLength": 132,
        "pattern": "^ast_[A-Za-z0-9_-]{8,128}$"
      },
      "AttachmentKind": {
        "type": "string",
        "enum": [
          "audio",
          "image",
          "document"
        ]
      },
      "AttachmentMimeType": {
        "type": "string",
        "minLength": 3,
        "maxLength": 191,
        "pattern": "^[a-z][a-z0-9!#$&^_.+-]{0,63}/[a-z0-9][a-z0-9!#$&^_.+-]{0,126}$"
      },
      "AttachmentSha256": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      },
      "AttachmentRef": {
        "type": "object",
        "additionalProperties": false,
        "description": "Opaque, JSON-safe attachment metadata. Object-storage keys, raw bytes, authorization metadata and signed URL query parameters are never part of this boundary. Image and document kinds are reserved for future adapters and are not accepted by the current ask request.",
        "required": [
          "asset_id",
          "kind",
          "mime_type",
          "status"
        ],
        "properties": {
          "asset_id": {
            "$ref": "#/components/schemas/AttachmentId"
          },
          "kind": {
            "$ref": "#/components/schemas/AttachmentKind"
          },
          "mime_type": {
            "$ref": "#/components/schemas/AttachmentMimeType"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "ready",
              "failed"
            ]
          },
          "byte_length": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "$ref": "#/components/schemas/AttachmentSha256"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "url": {
            "type": "string",
            "format": "uri-reference",
            "maxLength": 2048,
            "pattern": "^(?:/(?!/)[^\\s?#]*|https?://[^\\s?#]+)$"
          }
        }
      },
      "EventStreamEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "description": "HTTP projection of the normative events.yaml envelope.",
        "required": [
          "specversion",
          "id",
          "type",
          "source",
          "subject",
          "time",
          "datacontenttype",
          "tenant_id",
          "request_id",
          "data"
        ],
        "properties": {
          "specversion": {
            "const": "1.0"
          },
          "id": {
            "type": "string",
            "pattern": "^evt_[0-9a-fA-F-]{36}$"
          },
          "type": {
            "type": "string",
            "enum": [
              "voice.request.received.v1",
              "voice.transcript.created.v1",
              "voice.understanding.created.v1",
              "crm.command.committed.v1",
              "crm.review.requested.v1",
              "tts.asset.created.v1",
              "voice.request.failed.v1"
            ]
          },
          "source": {
            "type": "string",
            "const": "urn:sumi:voice-crm/crm",
            "format": "uri"
          },
          "subject": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "time": {
            "type": "string",
            "format": "date-time"
          },
          "datacontenttype": {
            "const": "application/json"
          },
          "tenant_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "request_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "traceparent": {
            "type": "string",
            "pattern": "^00-[0-9a-f]{32}-[0-9a-f]{16}-[0-9a-f]{2}$"
          },
          "data": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "EventStreamResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "events",
          "request_id"
        ],
        "properties": {
          "events": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EventStreamEnvelope"
            }
          },
          "request_id": {
            "$ref": "#/components/schemas/RequestId"
          }
        }
      },
      "TextInput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "text"
        ],
        "properties": {
          "type": {
            "const": "text"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          }
        }
      },
      "AudioInput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type"
        ],
        "description": "Base64 audio is the normal JSON representation. The nullable deprecated alias is retained so an explicitly empty source reaches the documented 422 NO_AUDIO_SOURCE boundary instead of becoming a protocol 400.",
        "properties": {
          "type": {
            "const": "audio"
          },
          "data_base64": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "contentEncoding": "base64",
            "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
          },
          "content_type": {
            "type": "string",
            "enum": [
              "audio/wav",
              "audio/x-wav",
              "audio/mpeg",
              "audio/mp4",
              "audio/webm"
            ],
            "default": "audio/wav"
          },
          "audio": {
            "type": "null",
            "description": "Deprecated compatibility alias for an empty audio source."
          }
        }
      },
      "TextAskRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "input",
          "output_mode"
        ],
        "properties": {
          "input": {
            "$ref": "#/components/schemas/TextInput"
          },
          "output_mode": {
            "type": "string",
            "enum": [
              "text",
              "audio",
              "both"
            ]
          },
          "locale": {
            "$ref": "#/components/schemas/Locale"
          },
          "conversation_id": {
            "type": "string",
            "maxLength": 128
          }
        }
      },
      "AudioAskRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "input",
          "output_mode"
        ],
        "properties": {
          "input": {
            "$ref": "#/components/schemas/AudioInput"
          },
          "output_mode": {
            "type": "string",
            "enum": [
              "text",
              "audio",
              "both"
            ]
          },
          "locale": {
            "$ref": "#/components/schemas/Locale"
          },
          "conversation_id": {
            "type": "string",
            "maxLength": 128
          }
        }
      },
      "AskRequest": {
        "description": "JSON request union. The nested const input.type values make the variants mutually exclusive.",
        "oneOf": [
          {
            "$ref": "#/components/schemas/TextAskRequest"
          },
          {
            "$ref": "#/components/schemas/AudioAskRequest"
          }
        ]
      },
      "MultipartAudioAskRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "audio",
          "metadata"
        ],
        "properties": {
          "audio": {
            "type": "string",
            "format": "binary"
          },
          "metadata": {
            "type": "string",
            "contentMediaType": "application/json",
            "contentSchema": {
              "$ref": "#/components/schemas/MultipartAskMetadata"
            },
            "description": "JSON-encoded object containing output_mode, locale and optional conversation_id."
          }
        }
      },
      "MultipartAskMetadata": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "output_mode": {
            "type": "string",
            "enum": [
              "text",
              "audio",
              "both"
            ],
            "default": "both"
          },
          "locale": {
            "$ref": "#/components/schemas/Locale"
          },
          "conversation_id": {
            "type": "string",
            "maxLength": 128
          }
        }
      },
      "Understanding": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "intent",
          "confidence",
          "entities",
          "missing",
          "needs_confirmation",
          "schema_version"
        ],
        "properties": {
          "intent": {
            "type": "string"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "entities": {
            "type": "object",
            "additionalProperties": true
          },
          "missing": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "needs_confirmation": {
            "type": "boolean"
          },
          "schema_version": {
            "type": "string"
          },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "transcript_hash": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "language": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16
              },
              "model": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              }
            }
          }
        }
      },
      "AskResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "request_id",
          "status",
          "input",
          "understanding",
          "answer"
        ],
        "properties": {
          "request_id": {
            "$ref": "#/components/schemas/RequestId"
          },
          "status": {
            "const": "completed"
          },
          "input": {
            "type": "object",
            "additionalProperties": true
          },
          "understanding": {
            "$ref": "#/components/schemas/Understanding"
          },
          "crm": {
            "type": "object",
            "additionalProperties": true
          },
          "answer": {
            "type": "object",
            "required": [
              "text"
            ],
            "properties": {
              "text": {
                "type": "string"
              },
              "language": {
                "type": "string"
              }
            }
          },
          "audio": {
            "$ref": "#/components/schemas/TtsAsset"
          }
        }
      },
      "ReviewResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "request_id",
          "status",
          "input",
          "understanding",
          "answer",
          "review_task"
        ],
        "properties": {
          "request_id": {
            "$ref": "#/components/schemas/RequestId"
          },
          "status": {
            "const": "needs_review"
          },
          "input": {
            "type": "object",
            "additionalProperties": true
          },
          "understanding": {
            "$ref": "#/components/schemas/Understanding"
          },
          "answer": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "text"
            ],
            "properties": {
              "text": {
                "type": "string"
              },
              "language": {
                "$ref": "#/components/schemas/Locale"
              }
            }
          },
          "review_task": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "expires_at": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      },
      "ReviewId": {
        "type": "string",
        "pattern": "^(rev_[A-Za-z0-9_-]{4,64}|[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89ab][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$"
      },
      "ReviewDecisionRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "decision"
        ],
        "properties": {
          "decision": {
            "type": "string",
            "enum": [
              "approve",
              "reject"
            ]
          },
          "correction": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "ReviewDecisionResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "review_id",
          "status",
          "decision"
        ],
        "properties": {
          "review_id": {
            "$ref": "#/components/schemas/ReviewId"
          },
          "status": {
            "type": "string",
            "enum": [
              "approved",
              "rejected"
            ]
          },
          "decision": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "TtsRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text",
          "language",
          "format"
        ],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 5000
          },
          "language": {
            "$ref": "#/components/schemas/Locale"
          },
          "voice": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "format": {
            "type": "string",
            "enum": [
              "mp3",
              "wav",
              "ogg"
            ]
          }
        }
      },
      "TtsAsset": {
        "type": "object",
        "additionalProperties": false,
        "description": "Source-compatible audio response. New transport-neutral adapters use AttachmentRef; the optional common fields allow incremental adoption without changing existing TTS response requirements.",
        "required": [
          "asset_id",
          "url",
          "mime_type",
          "status"
        ],
        "properties": {
          "asset_id": {
            "$ref": "#/components/schemas/AttachmentId"
          },
          "kind": {
            "$ref": "#/components/schemas/AttachmentKind"
          },
          "url": {
            "type": "string",
            "format": "uri-reference",
            "maxLength": 2048,
            "pattern": "^(?:/(?!/)[^\\s?#]*|https?://[^\\s?#]+)$"
          },
          "mime_type": {
            "$ref": "#/components/schemas/AttachmentMimeType"
          },
          "byte_length": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "$ref": "#/components/schemas/AttachmentSha256"
          },
          "duration_ms": {
            "type": "integer",
            "minimum": 0
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "type": "string",
            "enum": [
              "ready",
              "failed",
              "pending"
            ]
          },
          "voice": {
            "type": "string"
          },
          "provider": {
            "type": "string"
          },
          "model": {
            "type": "string"
          }
        }
      },
      "TtsSynthesizeResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "request_id",
          "asset",
          "idempotency_replay"
        ],
        "properties": {
          "request_id": {
            "$ref": "#/components/schemas/RequestId"
          },
          "asset": {
            "$ref": "#/components/schemas/TtsAsset"
          },
          "idempotency_replay": {
            "type": "boolean"
          }
        }
      },
      "ErrorEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "request_id",
          "status",
          "error"
        ],
        "properties": {
          "request_id": {
            "$ref": "#/components/schemas/RequestId"
          },
          "status": {
            "const": "failed"
          },
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "message",
              "retryable",
              "details"
            ],
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "INVALID_REQUEST",
                  "UNAUTHORIZED",
                  "FORBIDDEN",
                  "UNSUPPORTED_MEDIA",
                  "NO_AUDIO_SOURCE",
                  "EMPTY_TRANSCRIPT",
                  "INTENT_LOW_CONFIDENCE",
                  "CRM_CONFLICT",
                  "ASR_TIMEOUT",
                  "IDEMPOTENCY_CONFLICT",
                  "UPSTREAM_UNAVAILABLE",
                  "PROVIDER_REJECTED",
                  "RATE_LIMITED",
                  "PAYLOAD_TOO_LARGE"
                ]
              },
              "message": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              "retryable": {
                "type": "boolean"
              },
              "details": {
                "type": "object",
                "additionalProperties": true
              }
            }
          }
        }
      }
    }
  }
}
