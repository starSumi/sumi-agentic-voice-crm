{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sumi.invalid/schemas/protocol-manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "protocol_version",
    "owner",
    "sources",
    "generated",
    "commands",
    "breaking_change_policy",
    "rollback"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": "sumi.protocol-manifest.v1" },
    "protocol_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "owner": { "const": "protocol-owner" },
    "compatibility": { "enum": ["additive-by-default"] },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "http",
        "events",
        "agent_crm_intents",
        "supervisor",
        "authorization",
        "transports",
        "database"
      ],
      "properties": {
        "http": { "type": "string" },
        "events": { "type": "string" },
        "agent_crm_intents": { "type": "string" },
        "supervisor": { "type": "string" },
        "authorization": { "type": "string" },
        "transports": { "type": "string" },
        "database": { "type": "string" }
      }
    },
    "generated": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "json_schema_bundle",
        "event_schema_bundle",
        "typescript_client",
        "typescript_supervisor",
        "typescript_agent_crm",
        "rust_supervisor"
      ],
      "properties": {
        "json_schema_bundle": { "type": "string" },
        "event_schema_bundle": { "type": "string" },
        "typescript_client": { "type": "string" },
        "typescript_supervisor": { "type": "string" },
        "typescript_agent_crm": { "type": "string" },
        "rust_supervisor": { "type": "string" }
      }
    },
    "consumer_roots": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "commands": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generate",
        "drift_check",
        "authorization_check",
        "consumer_check"
      ],
      "properties": {
        "generate": { "type": "string" },
        "drift_check": { "type": "string" },
        "authorization_check": { "type": "string" },
        "consumer_check": { "type": "string" }
      }
    },
    "breaking_change_policy": { "type": "string", "minLength": 1 },
    "rollback": { "type": "string", "minLength": 1 }
  }
}
